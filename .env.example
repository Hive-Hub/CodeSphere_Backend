# Flask Core Configuration
FLASK_ENV=production
DEBUG=false
SECRET_KEY=your-production-flask-secret-key
PORT=10000

# JWT & Session Expiry Settings
JWT_SECRET_KEY=your-production-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
SESSION_EXPIRY_HOURS=24

# Database Configuration (PostgreSQL / Supabase Postgres)
DATABASE_URL=postgresql://username:password@db.supabase.co:5432/postgres
DEV_DATABASE_URL=sqlite:///dev.db

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Redis Configuration (Upstash Redis)
REDIS_URL=rediss://default:password@your-redis.upstash.io:6379/0?ssl_cert_reqs=none
CELERY_BROKER_URL=rediss://default:password@your-redis.upstash.io:6379/0?ssl_cert_reqs=none
CELERY_RESULT_BACKEND=rediss://default:password@your-redis.upstash.io:6379/1?ssl_cert_reqs=none

# Online Code Execution Engine (OnlineCompiler.io REST API)
ONLINE_COMPILER_API_KEY=your-online-compiler-api-key
ONLINE_COMPILER_BASE_URL=https://api.onlinecompiler.io
ONLINE_COMPILER_TIMEOUT=35

# AI Integration Configuration (Google AI Studio Gemini & OpenAI)
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Code & Input Limits
MAX_CODE_SIZE=100000
MAX_INPUT_SIZE=100000

# Rate Limiting & Security
RATE_LIMIT_DEFAULT=200 per day
RATE_LIMIT_STRICT=10 per minute
FRONTEND_URL=https://codesphere.ai
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://codesphere.ai
